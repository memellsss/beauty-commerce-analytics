                "    Fonte = LerCsv(\"backtest.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"mes\", type date}, {\"categoria_id\", type text}, {\"metodo\", type text}, {\"unidades_reais\", Int64.Type}, {\"unidades_previstas\", Int64.Type}, {\"erro_absoluto\", Int64.Type}}, \"en-US\")",
                "in",
