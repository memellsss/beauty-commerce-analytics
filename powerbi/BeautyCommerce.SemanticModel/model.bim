            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = LerCsv(\"calendario.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"data\", type date}, {\"ano_mes\", type text}, {\"ano\", Int64.Type}}, \"en-US\")",
                "in",
