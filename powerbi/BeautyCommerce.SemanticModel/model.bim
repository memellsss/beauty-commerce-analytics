{
  "name": "BeautyCommerce",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "pt-BR",
    "sourceQueryCulture": "pt-BR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": false
    },
    "annotations": [
      {
        "name": "PBI_ProTooling",
        "value": "[\"DevMode\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBI_QueryOrder",
        "value": "[\"PastaDados\", \"LerCsv\", \"Calendário\", \"Categorias\", \"Produtos\", \"Vendas\", \"Previsão\", \"Backtest\"]"
      }
    ],
    "expressions": [
      {
        "name": "PastaDados",
        "kind": "m",
        "lineageTag": "192b7347-dc17-5b17-a144-4e0fc49f023a",
        "expression": "\"GitHub\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      },
      {
        "name": "LerCsv",
        "kind": "m",
        "lineageTag": "00c735bd-97fd-5085-b2e6-684ebde8ee7e",
        "expression": [
          "(Nome as text) as table =>",
          "let",
          "    Conteudo = if PastaDados = \"GitHub\" then",
          "        Web.Contents(\"https://raw.githubusercontent.com\", [RelativePath = \"memellsss/beauty-commerce-analytics/main/data/curated/\" & Nome])",
          "        else File.Contents(PastaDados & \"/\" & Nome),",
          "    Linhas = Csv.Document(Conteudo, [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
          "    Cabecalhos = Table.PromoteHeaders(Linhas, [PromoteAllScalars = true])",
          "in",
          "    Cabecalhos"
        ]
      }
    ],
    "tables": [
      {
        "name": "Calendário",
        "isHidden": false,
        "lineageTag": "3ed6ad10-61f1-5662-b603-d6158743287d",
