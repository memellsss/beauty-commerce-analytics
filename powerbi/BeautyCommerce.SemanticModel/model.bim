              ]
            }
          }
        ],
        "measures": [
          {
            "name": "WAPE no teste",
            "expression": "DIVIDE(SUM('Backtest'[Erro absoluto]), SUM('Backtest'[Unidades reais]))",
            "description": "Soma dos desvios absolutos por mês e categoria / total observado em out–dez/2025.",
            "lineageTag": "b8d1e352-6f4c-5069-8ee2-6b40ebf43acd",
            "formatString": "0.0%"
          }
        ]
