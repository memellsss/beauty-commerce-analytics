            "dataType": "decimal",
            "sourceColumn": "receita_liquida",
            "summarizeBy": "none",
            "lineageTag": "98af0afb-61da-59c0-8292-0940f39c2e69"
          }
        ],
        "partitions": [
          {
            "name": "Vendas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = LerCsv(\"vendas.csv\"),",
                "    Tipos = Table.TransformColumnTypes(Fonte, {{\"pedido_id\", type text}, {\"item\", Int64.Type}, {\"data\", type date}, {\"produto_id\", type text}, {\"categoria_id\", type text}, {\"canal\", type text}, {\"quantidade\", Int64.Type}, {\"preco_unitario\", Currency.Type}, {\"desconto_pct\", Int64.Type}, {\"receita_liquida\", Currency.Type}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Receita líquida",
            "expression": "SUM('Vendas'[Valor líquido])",
            "description": "Venda de produtos após descontos, sem frete ou impostos.",
            "lineageTag": "125e6c4c-9981-509f-89e3-9510a54f870e",
            "formatString": "\"R$ \" #,0.00"
          },
          {
            "name": "Pedidos",
            "expression": "DISTINCTCOUNT('Vendas'[ID do pedido])",
            "description": "Pedidos distintos no contexto dos filtros.",
            "lineageTag": "0010beee-8418-57af-9618-b18b02bec510",
            "formatString": "#,0"
          },
          {
            "name": "Unidades vendidas",
            "expression": "SUM('Vendas'[Quantidade])",
            "description": "Soma da quantidade vendida, não o número de linhas.",
            "lineageTag": "8bfd3f0b-e703-5ca7-9b97-822c0f13c094",
            "formatString": "#,0"
          },
          {
            "name": "Ticket médio",
            "expression": "DIVIDE([Receita líquida], [Pedidos])",
            "description": "Receita líquida por pedido distinto.",
            "lineageTag": "c51eb226-e83e-50f1-ad97-4f6d72f9e119",
            "formatString": "\"R$ \" #,0.00"
          }
        ]
      },
