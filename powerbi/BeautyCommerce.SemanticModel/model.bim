            "formatString": "#,0"
          },
          {
            "name": "Método escolhido",
            "expression": "SELECTEDVALUE('Previsão'[Método])",
            "description": "Método selecionado por categoria no período de validação.",
            "lineageTag": "561536a3-999f-524b-85ac-16f6da30b3b9"
          }
